{
  "name": "@chat/server",
  "version": "1.0.0",
  "private": true,
  "description": "Chat API: Express + PostgreSQL (chats, membership) + Firestore (messages, receipts, read progress)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "migrate:create": "tsx src/db/migrate.ts create",
    "emulators": "firebase emulators:start --only firestore --project demo-chat"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "@google-cloud/firestore": "9.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^17.10.0-beta.17",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
