rules_version = '2';

// The chat API reads and writes Firestore exclusively through the Admin SDK
// (server-side), which bypasses these rules. Direct client access is denied:
// no browser ever talks to Firestore in this application, so no document —
// messages, read receipts, or read progress — is reachable from a client.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
